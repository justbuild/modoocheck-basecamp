# Basecamp 서버가 호출할 modoocheck5-agent-api 주소.
BASECAMP_AGENT_API_BASE=http://localhost:4000

# 32바이트 base64url 키. 생성: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
BASECAMP_SESSION_KEY=CHANGE_ME_43_CHARACTER_BASE64URL_KEY

# Basecamp 자체 데이터베이스. 공식 모두출첵 Core DB와 분리됩니다.
DATABASE_FILENAME=basecamp.db
